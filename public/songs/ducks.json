{
  "id": "ducks",
  "title": "数鸭子",
  "cues": [
    {
      "at": 0.3,
      "text": "数鸭子"
    },
    {
      "at": 3.0,
      "text": "门前大桥下，游过一群鸭。"
    },
    {
      "at": 12.6,
      "text": "快来快来数一数，二四六七八。"
    },
    {
      "at": 22.2,
      "text": "嘎嘎嘎嘎，真呀真多呀。"
    },
    {
      "at": 31.8,
      "text": "数不清到底多少鸭。"
    }
  ]
}