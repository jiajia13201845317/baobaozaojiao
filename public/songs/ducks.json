{
  "id": "ducks",
  "title": "数鸭子",
  "cues": [
    {
      "at": 0.35,
      "text": "数鸭子"
    },
    {
      "at": 2.61,
      "text": "门前大桥下，游过一群小鸭子。"
    },
    {
      "at": 6.72,
      "text": "快来快来数一数，二，四，六，七，八。"
    },
    {
      "at": 12.38,
      "text": "嘎，嘎，嘎，嘎，真呀真多呀。"
    },
    {
      "at": 17.09,
      "text": "数不清到底多少小鸭子。"
    }
  ]
}